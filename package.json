{
  "name": "magpie-responses-shim",
  "version": "0.3.0",
  "description": "Magpie Responses provider and middleware that clean resource-bound history, including compaction requests",
  "type": "module",
  "main": "./provider.mjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JinPen-G/magpie-responses-shim.git"
  },
  "homepage": "https://github.com/JinPen-G/magpie-responses-shim#readme",
  "bugs": {
    "url": "https://github.com/JinPen-G/magpie-responses-shim/issues"
  },
  "keywords": [
    "magpie-plugin",
    "magpie",
    "middleware",
    "opencode",
    "opencode-plugin",
    "agentrouter",
    "openai",
    "responses"
  ],
  "files": [
    "responses.middleware.mjs",
    "provider.mjs",
    "lib/sanitize.mjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test tests/middleware.test.mjs tests/provider.test.mjs",
    "test:magpie": "node tests/verify-magpie.mjs"
  },
  "magpie": {
    "name": "Responses 跨资源修复",
    "summary": {
      "zh": "清理 Responses 跨资源历史，供应商模式覆盖普通请求与 Magpie 压缩摘要请求。",
      "en": "Clean resource-bound Responses history. Provider mode also covers Magpie compaction summaries."
    },
    "middleware": "./responses.middleware.mjs",
    "options": {
      "providers": ["agentrouter"],
      "log": false,
      "upstream": "https://agentrouter.org/v1"
    }
  }
}
